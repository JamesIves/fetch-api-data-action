{
  "name": "@jamesives/fetch-api-data-action",
  "description": "GitHub action for handling authenticated API requests, allowing you to save the data from the request into your workspace as an environment variable and a .json file.",
  "author": "James Ives <iam@jamesiv.es> (https://jamesiv.es)",
  "version": "2.5.1",
  "license": "MIT",
  "type": "module",
  "main": "lib/lib.js",
  "types": "lib/lib.d.ts",
  "root": true,
  "scripts": {
    "build": "rm -rf lib && tsc --declaration",
    "test": "jest",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "lint:format": "prettier --write .",
    "lint:format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JamesIves/fetch-api-data-action.git"
  },
  "bugs": {
    "url": "https://github.com/JamesIves/fetch-api-data-action/issues"
  },
  "homepage": "https://github.com/JamesIves/fetch-api-data-action",
  "keywords": [
    "actions",
    "api",
    "data",
    "fetch",
    "json",
    "store",
    "ssr",
    "github",
    "github-action"
  ],
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/io": "3.0.2",
    "@eslint/js": "10.0.1",
    "async-retry": "1.3.3",
    "mustache": "4.2.0"
  },
  "devDependencies": {
    "@types/async-retry": "1.4.9",
    "@types/jest": "30.0.0",
    "@types/mustache": "4.2.6",
    "@types/node": "26.2.0",
    "@types/retry": "0.12.5",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.16.0",
    "eslint-plugin-prettier": "5.5.6",
    "jest": "30.4.2",
    "jest-circus": "30.4.2",
    "prettier": "3.9.6",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  }
}
